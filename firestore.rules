rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Strict user-level isolation: authenticated users can only read/write their own profile subtree
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read-only syllabus metadata / leaderboard snapshots
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == docId;
    }
  }
}
